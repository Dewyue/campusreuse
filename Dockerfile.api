FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY backend ./backend
COPY shared ./shared
ENV HOST=0.0.0.0 PORT=3100 DATA_DIR=/data
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 3100
CMD ["node", "--experimental-strip-types", "backend/server.js"]
