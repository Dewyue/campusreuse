{
  "name": "csu-campus-market",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite frontend --host 0.0.0.0",
    "server": "node --experimental-strip-types backend/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build frontend",
    "build:preview": "tsc --noEmit && vite build frontend --mode preview --outDir ../dist",
    "test": "node --experimental-strip-types --test backend/*.test.js backend/*.test.ts",
    "test:chat-ui": "node --experimental-strip-types frontend/chat-flow-check.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "^1.51.0",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  }
}
